<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <!--<TargetFramework>net10.0</TargetFramework>-->
		<TargetFrameworks>net10.0</TargetFrameworks>
    <Version>0.1.0</Version>
    <Nullable>disable</Nullable>
    <RootNamespace>IczpNet.Chat</RootNamespace>
    <Authors>IczpNet</Authors>
    <RepositoryUrl>https://github.com/Iczp/Chat.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Iczp/Chat.git</PackageProjectUrl>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Copyright>(c) iczp.net</Copyright>
    <Description>Chat module for abp</Description>
    <PackageIcon>IczpNet.jpg</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\IczpNet.AbpCommons\src\IczpNet.AbpCommons.Domain.Shared\IczpNet.AbpCommons.Domain.Shared.csproj" />
    <PackageReference Include="IczpNet.AbpTrees.Domain.Shared" Version="10.0.0.1061" />
    <PackageReference Include="Volo.Abp.Identity.Domain.Shared" Version="10.6.1" />
    <PackageReference Include="Volo.Abp.Validation" Version="10.6.1" />
  </ItemGroup>

  <ItemGroup>
    <!--<PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.9" />-->
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\Chat\*.json" />
    <Compile Remove="DataFilters\**" />
    <Compile Remove="Sessions\SessionPermissionDefinitions\**" />
    <Content Remove="Localization\Chat\*.json" />
    <EmbeddedResource Remove="DataFilters\**" />
    <EmbeddedResource Remove="Sessions\SessionPermissionDefinitions\**" />
    <None Remove="DataFilters\**" />
    <None Remove="Sessions\SessionPermissionDefinitions\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\IczpNet.jpg" Link="IczpNet.jpg">
      <PackagePath>\</PackagePath>
      <Pack>True</Pack>
    </None>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="ConfigureAwait.Fody" Version="3.4.1" />
    <PackageReference Update="Fody" Version="6.9.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="SessionPermissions\Dtos\" />
  </ItemGroup>
</Project>
